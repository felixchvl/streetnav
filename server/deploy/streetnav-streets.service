[Unit]
Description=Streetnav: streets ridden and not ridden, around the new rides
After=postgresql.service

[Service]
Type=oneshot
User=streetnav
EnvironmentFile=/etc/streetnav/streetnav.env
WorkingDirectory=/opt/streetnav
ExecStart=/opt/streetnav/venv/bin/python -m streetnav_server.streets refresh
MemoryMax=512M
