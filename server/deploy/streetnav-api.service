[Unit]
Description=Streetnav API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=streetnav
WorkingDirectory=/opt/streetnav
EnvironmentFile=/etc/streetnav/streetnav.env
ExecStart=/opt/streetnav/venv/bin/uvicorn streetnav_server.api:app --host 0.0.0.0 --port 8080 --workers 1
Restart=on-failure
MemoryMax=512M

[Install]
WantedBy=multi-user.target
